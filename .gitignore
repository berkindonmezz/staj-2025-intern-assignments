# # # GENEL # # #

# İşletim sistemine özel, gereksiz dosyalar
.DS_Store
Thumbs.db
desktop.ini

# Log ve geçici dosyalar
*.log
*.tmp
*.temp

# Popüler IDE'lere ve editörlere özel ayar klasörleri
.idea/
.vscode/
*.iml
*.suo
.project
.buildpath
.settings/


# # # FLUTTER - /mobil/login_app/ ###

# Flutter'ın proje durumunu ve bağımlılıklarını tuttuğu geçici klasörler
/mobil/login_app/.dart_tool/
/mobil/login_app/.metadata
/mobil/login_app/.flutter-plugins
/mobil/login_app/.flutter-plugins-dependencies

# Flutter'ın derleme sonrası ürettiği ve cihaza yüklenen uygulama dosyaları
/mobil/login_app/build/

# IntelliJ (Android Studio) modül dosyaları
/mobil/login_app/android/.gradle/
/mobil/login_app/android/app/src/main/jniLibs/
/mobil/login_app/android/app/profile/
/mobil/login_app/android/app/release/


# # # .NET (Backend) - /backend/ ###

# .NET'in derleme sonrası ürettiği çalıştırılabilir dosyalar ve kütüphaneler
# **/ kullanımı, 'backend' altındaki tüm alt klasörleri de kapsar.
/backend/**/bin/
/backend/**/obj/

# Kullanıcıya özel ayar dosyaları
/backend/*.user
/backend/*.userosscache
/backend/*.sln.docstates

# Visual Studio'ya özel klasörler
/backend/.vs/
/backend/TestResults/


# # # NODE.JS (Frontend - React/Angular/Vue) - /frontend/ ###

# Paket klasörü
/frontend/node_modules/

# Derleme sonrası oluşan ve sunucuya yüklenen statik dosyalar
/frontend/build/
/frontend/dist/
/frontend/.next/

# Hata ve debug logları
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Diğer
.pnp.*
.env.local
.env.development.local
.env.test.local
.env.production.local